# Copy to docker/.env (git-ignored) and fill in.

# Cesium ion access token (baked into the browser bundle at build time).
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# Site password, and a random secret that signs the session cookie.
# Generate the secret with:  openssl rand -hex 32
APP_PASSWORD=Ocean1234
AUTH_SECRET=

# Where the survey data lives on the host (mounted read-only).
DATA_PATH=../public/tonga

# Port on the host. Set APP_BIND=127.0.0.1 behind a reverse proxy.
APP_PORT=3000
APP_BIND=0.0.0.0

# Set to true once the site is served over HTTPS.
COOKIE_SECURE=false

# Scraping limits (per signed-in session).
DATA_MAX_RANGE_MB=16
DATA_RATE_MB=600
DATA_RATE_WINDOW_S=900
