# Copy to docker/.env (git-ignored) and fill in. Never put real values here:
# this file is committed.

# Cesium ion access token (baked into the browser bundle at build time).
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# Login for the whole app (viewer, products and data). Leaving either empty
# turns the login off, so both are required in production.
APP_USERNAME=
APP_PASSWORD=

# Random secret that signs the session cookie; deploy.sh generates one.
# Changing it signs everyone out.  openssl rand -hex 32
AUTH_SECRET=

# Where the survey data lives on the host (mounted read-only).
DATA_PATH=../public/tonga

# Port on the host that nginx proxies /pointcloud to. 127.0.0.1 keeps the app
# reachable only through nginx.
APP_PORT=3120
APP_BIND=127.0.0.1

# The site is served over HTTPS (nginx); set false only for plain-HTTP testing.
COOKIE_SECURE=true

# Scraping limits (per signed-in session).
DATA_MAX_RANGE_MB=16
DATA_RATE_MB=600
DATA_RATE_WINDOW_S=900
