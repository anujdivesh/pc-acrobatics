# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: hold the Cesium ion token, never committed
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# public assets are never committed: Cesium and laz-perf files are copied in from
# node_modules by scripts/, and the survey data is far too large for git
/public
